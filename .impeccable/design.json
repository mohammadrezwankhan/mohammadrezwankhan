  "narrative": {
    "northStar": "Battery insight becomes engineering evidence.",
    "overview": "The existing amber, cream, coral, and violet pixel energy core anchors the identity. Crisp geometry, a dark field, readable type, and two restrained moving signals connect the artwork without turning it into a scientific result.\n\nThe GitHub profile uses native Markdown hierarchy; the optional gallery carries the custom CSS. Textual identity, project routes, and evidence remain readable outside the artwork. The refresh preserves the original engineering material and earlier visuals.",
    "keyCharacteristics": [
      "Recognisable source emblem and fixed typography.",
      "Compact, self-contained assets with static alternatives.",
      "Clear routes into source, methods, evidence, and limitations."
    ],
    "rules": [],
    "dos": [
      "Do retain the canonical pixel geometry and the user's recognisable identity.",
      "Do keep names, project choices, scientific limits, and links readable outside artwork.",
      "Do retain static assets, reduced-motion behavior, and the gallery pause control.",
      "Do regenerate derived files from their sources and preserve provenance and snapshots."
    ],
    "donts": [
